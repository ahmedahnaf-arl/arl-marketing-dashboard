# PostgreSQL connection string (Supabase / Neon pooler or any Postgres).
# For cloud Postgres use a URL with sslmode=require, e.g.:
#   DATABASE_URL=postgres://user:password@host:5432/postgres?sslmode=require
# For a local Postgres, drop the sslmode param:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/akij_calendar
DATABASE_URL=
